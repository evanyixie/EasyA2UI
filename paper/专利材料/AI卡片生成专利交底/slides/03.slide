    <Box style={{ height: 58, marginTop: 16, display: 'flex', flexDirection: 'row', gap: 12 }}>
      <Box style={{ flex: 1, border: '1px solid #E6E6E6', borderRadius: 6, display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 8 }}>
        <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#8B1E24', fontFamily: "'Helvetica Neue',Arial,sans-serif" }}>L1 → L2</Text>
        <Text style={{ fontSize: 12.5, color: '#595959', fontFamily: "'Source Han Sans SC','Microsoft YaHei',sans-serif" }}>几何（数字）交给程序</Text>
