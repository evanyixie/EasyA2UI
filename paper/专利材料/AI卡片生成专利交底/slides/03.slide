      <Box style={{ flex: 1, border: '1px solid #E6E6E6', borderRadius: 6, display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 8 }}>
        <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#8B1E24', fontFamily: "'Helvetica Neue',Arial,sans-serif" }}>L3 → L4</Text>
        <Text style={{ fontSize: 12.5, color: '#595959', fontFamily: "'Source Han Sans SC','Microsoft YaHei',sans-serif" }}>结构选择权交给程序</Text>
      </Box>
    </Box>

    <Box style={{ marginTop: 14, display: 'flex', alignItems: 'center' }}>
      <Text style={{ fontSize: 14.5, color: '#1A1A1A', fontFamily: "'Source Han Sans SC','Microsoft YaHei',sans-serif", lineHeight: 1.5 }}>
        模型的决策范围逐档收窄：L1 全部包办 → L4 仅剩语义抽取；<span style={{ color: '#8B1E24', fontWeight: 'bold' }}>每移交一项决策，就把一类错误从「概率性发生」变成「构造上不可能」</span>。
      </Text>
    </Box>
