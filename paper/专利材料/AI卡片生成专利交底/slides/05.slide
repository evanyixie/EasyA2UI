          { text: '语义属性含组件位置信息与尺寸——模型参与几何决策', cellStyle: { padding: { top: 5, bottom: 5, left: 10, right: 8 } } },
          { text: '语义计划零几何量（领域 / 对象 / 字段 / 动作），模型不触碰任何坐标、尺寸、字号', cellStyle: { background: { color: '#F7F7F7' }, padding: { top: 5, bottom: 5, left: 10, right: 8 } } },
