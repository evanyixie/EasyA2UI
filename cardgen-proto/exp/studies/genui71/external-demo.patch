diff --git a/src/genui_device/intent_integrity.py b/src/genui_device/intent_integrity.py
index 300816b85025e5f3adb7b6ac6aa4623ef8cc783b..430a16b2c748e559c31de7c76f8f78206261491d 100644
--- a/src/genui_device/intent_integrity.py
+++ b/src/genui_device/intent_integrity.py
@@ -74,0 +75,58 @@ def prepare_intent(request, intent, *, audit):
+def peer_action_owners(request, intent):
+    """仅闭合的双实体独立操作可进入商用双分区，不推断未知或共享动作。"""
+    from .semantic_components import aligned
+
+    if not aligned(request) or request.size != '2x4':
+        return {}
+    facts = {fact.id: fact for fact in request.facts}
+    actions = {action.id: action for action in request.actions}
+    groups = {}
+    buttons = []
+    primary_groups = set()
+    for item in intent.items:
+        if item.role == 'title':
+            return {}
+        if item.role == 'action':
+            if item.component not in {'PillButton', 'CardButton'}:
+                return {}
+            buttons.append(item)
+            continue
+        if item.action_ref or not item.fact_refs:
+            return {}
+        entities = groups.setdefault(item.group, set())
+        for ref in item.fact_refs:
+            fact = facts.get(ref)
+            if fact is None or not fact.entity:
+                return {}
+            entities.add(fact.entity)
+        if item.role == 'primary':
+            primary_groups.add(item.group)
+    if len(groups) != 2 or len(buttons) != 2 or set(groups) != primary_groups:
+        return {}
+    entity_groups = {}
+    for group, entities in groups.items():
+        if len(entities) != 1:
+            return {}
+        entity = next(iter(entities))
+        if entity in entity_groups:
+            return {}
+        entity_groups[entity] = group
+    owners = {}
+    claimed = set()
+    for item in buttons:
+        action = actions.get(item.action_ref)
+        if action is None:
+            return {}
+        if action.entity:
+            owner = entity_groups.get(action.entity)
+        else:
+            owner = item.group if item.group in groups else None
+        if owner is None or owner in claimed:
+            return {}
+        if item.group in groups and item.group != owner:
+            return {}
+        owners[item.id] = owner
+        claimed.add(owner)
+    return owners
+
+
@@ -79,0 +138,13 @@ def canonical_actions(request, intent, *, audit=None):
+    owned = peer_action_owners(request, intent)
+    if owned:
+        items = []
+        for item in intent.items:
+            if item.id in owned and item.component == 'CardButton':
+                if audit is not None:
+                    audit.append(dict(kind='entity_action_component', item=item.id,
+                        declared_component='CardButton', component='PillButton',
+                        action_ref=item.action_ref, policy='commercial-peer-actions-v1'))
+                item = item.model_copy(update={'component': 'PillButton'})
+            items.append(item)
+        return intent.model_copy(update={'items': items})
+
diff --git a/src/genui_device/measure.py b/src/genui_device/measure.py
index 6aaa59bb38b56543dcdd9324ab46dad93f101de7..956e94198d858a001e37b1602a9ff394aba89ac4 100644
--- a/src/genui_device/measure.py
+++ b/src/genui_device/measure.py
@@ -40,0 +41,31 @@ class MeasureOracle(Protocol):
+class CachedMeasure:
+    """只读测量源的一次试排缓存；不用于会增补结果的原生查询发现器。"""
+
+    def __init__(self, oracle):
+        self.oracle, self.kind = oracle, oracle.kind
+        self.cache, self.requests, self.hits = {}, 0, 0
+
+    def text(self, value, width, font_size, *, max_lines, bold=False, line_height=1.35):
+        key = value, width, font_size, max_lines, bold, line_height
+        self.requests += 1
+        if key in self.cache:
+            self.hits += 1
+            valid, result = self.cache[key]
+            if not valid:
+                raise CapacityError(result)
+            return result
+        try:
+            result = self.oracle.text(value, width, font_size, max_lines=max_lines,
+                                      bold=bold, line_height=line_height)
+        except CapacityError as exc:
+            self.cache[key] = False, str(exc)
+            raise
+        self.cache[key] = True, result
+        return result
+
+    def evidence(self):
+        return dict(kind=self.kind, requests=self.requests, hits=self.hits,
+                    unique_queries=len(self.cache), scope='single_reference_evaluation',
+                    limitation='只读oracle调用缓存，不是实时原生查询计数或设备性能')
+
+
