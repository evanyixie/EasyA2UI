+    minimum_height: int = 0
+
+
+def atomic_text_recipes(component, size, *, numeric=False):
+    """只用于 upstream-card-v1，不改变历史复合组件和静态正文。"""
+    recipes = {
+        "SingleLineTitle": (TextRecipe(12, 400, minimum_height=12),),
+        "EmphasizedData": (TextRecipe(30, 700, minimum_height=30),),
+        "EmphasisText": (
+            TextRecipe(18, 700, maximum_lines=2, minimum_height=18),
+            TextRecipe(12, 400, line_height=16 / 12, minimum_height=16),
+        ),
+        "InfoBlock": (
+            TextRecipe(16, 700, line_height=22 / 16, minimum_height=22),
+            TextRecipe(12, 500, line_height=16 / 12, minimum_height=16),
+        ),
+        "DataDisplay": (
+            TextRecipe(12, 500, line_height=18 / 12, minimum_height=18),
+            TextRecipe(48, 700, line_height=60 / 48, minimum_height=60)
+            if numeric else TextRecipe(21, 700, line_height=1.25,
+                                       maximum_lines=2),
+            TextRecipe(14, 400, line_height=20 / 14, minimum_height=20),
+        ),
+    }
+    if component == "InfoBlock" and size == "2x4":
+        return (
+            TextRecipe(14, 700, line_height=19 / 14, minimum_height=19),
+            recipes["InfoBlock"][1],
+        )
+    return recipes[component]
+
+
+def atomic_unit_recipe(component):
+    font_size = 10 if component == "InfoBlock" else 12
+    minimum_height = 16 if component == "InfoBlock" else 12
+    return TextRecipe(font_size, 500, minimum_height=minimum_height)
